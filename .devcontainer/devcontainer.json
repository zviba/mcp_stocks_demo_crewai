{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_crewai_app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // uv sync creates .venv from uv.lock. CrewAI is a large dependency tree, so
  // the first run in a fresh container takes a couple of minutes.
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; uv sync; echo '✅ Environment synced from uv.lock'",
  "postAttachCommand": {
    "server": "uv run streamlit run streamlit_crewai_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Streamlit UI",
      "onAutoForward": "openPreview"
    },
    "8001": {
      "label": "FastAPI bridge (optional)",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    8501,
    8001
  ]
}
