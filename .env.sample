# Copy to .env and fill in.

# The crew runs on one of two providers. Set the key for the one you want —
# you do NOT need both. Without either, /analyze and the Streamlit
# "Start Analysis" button return {"error": "openai_api_key_required"}.
# The Streamlit sidebar can also take a key at runtime, which overrides these.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Google Gemini / AI Studio (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=AIza...

# Optional. Which provider a run uses when the UI/API does not name one:
# openai | gemini. Unset, the first provider with a key above wins.
# LLM_PROVIDER=openai

# Optional. Model per provider. A bare name is fine — the "<provider>/" routing
# prefix is added for you, so gemini-2.5-flash and gemini/gemini-2.5-flash are
# the same thing.
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Set to DEBUG to see the MCP handshake and every tool call in the logs.
# LOG_LEVEL=INFO
