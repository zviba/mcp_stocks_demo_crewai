# Copy to .env and fill in.

# Required to run the crew (/analyze, and the Streamlit "Start Analysis" button).
# Without it those return {"error": "openai_api_key_required"}.
# The Streamlit sidebar can also take a key at runtime, which overrides this one.
OPENAI_API_KEY=sk-...

# Optional. Model the crew runs on. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Optional. Set to DEBUG to see the MCP handshake and every tool call in the logs.
# LOG_LEVEL=INFO
